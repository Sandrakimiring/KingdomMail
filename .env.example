# Copy this file to .env and fill in real values. Never commit .env itself.

# --- Mailbox passwords (one per mailbox in config.yaml) ---
BALCOM_INFO_PASSWORD=  # info@balcom.solutions
BEACON_INFO_PASSWORD=  # info@beacon.contractors
GEOWELLS_INFO_PASSWORD=  # info@geowells.co.ke
KINGDOMAFRICA_INFO_PASSWORD=  # info@kingdom.africa
KINGDOMFOUNDATION_INFO_PASSWORD=  # info@kingdom.foundation
KINGDOMINSTITUTE_INFO_PASSWORD=  # info@kingdom.institute
KINGDOMASSETS_INFO_PASSWORD=  # info@kingdomassets.co.ke
KCAFRICA_INFO_PASSWORD=  # info@kingdomcapital.africa
KCGLOBAL_INFO_PASSWORD=  # info@kingdomcapital.global
KENERGIES_INFO_PASSWORD=  # info@kingdomenergies.com
KFOODS_INFO_PASSWORD=  # info@kingdomfoods.net
KGROUPHOLDING_INFO_PASSWORD=  # info@kingdomgroupholding.com
KINGDOMPAY_INFO_PASSWORD=  # info@kingdompay.org
KPROPERTIES_INFO_PASSWORD=  # info@kingdomproperties.africa
RAYENERGY_INFO_PASSWORD=  # info@rayenergy.co.ke
REGNUM_INFO_PASSWORD=  # info@regnum.media
SALEMHEALTH_INFO_PASSWORD=  # info@salemhealthcare.co.ke
SALEMPHARMA_INFO_PASSWORD=  # info@salempharmaceuticals.co.ke
SHILOH_INFO_PASSWORD=  # info@shilohelevators.com
SIALOENT_INFO_PASSWORD=  # info@sialoenterprises.com
SPIRITAFRICA_INFO_PASSWORD=  # info@spirit.africa

# --- Groq API key (free) - https://console.groq.com ---
GROQ_API_KEY=

# Optional: override the classification model.
# GROQ_MODEL=openai/gpt-oss-120b

# --- Telegram bot (free) - via @BotFather ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=   # digits only, no trailing comma

# Extra people allowed to ask questions (comma separated). Optional - you do not
# need this to add someone. Have them message the bot and you get an /approve
# command to send. Move settled ids here so they survive a redeploy.
TELEGRAM_ALLOWED_CHAT_IDS=

# Who receives pushed alerts, comma separated. Add a level per person:
#   TELEGRAM_ALERT_CHAT_IDS=111111:all,222222:important
# The owner above always receives them. Manage from Telegram with /alerts.
TELEGRAM_ALERT_CHAT_IDS=

# Passcode a user must send before the bot answers. Blank = no passcode.
BOT_PASSCODE=

# --- Recommended extras ---
# Shared secret the scheduler must send: /run-check?token=...
RUN_TOKEN=

# Shared secret Telegram sends with each webhook call (set it via setWebhook).
TELEGRAM_WEBHOOK_SECRET=

# Where state.json and known_senders.json are kept. Point this at a persistent
# disk if the host wipes its filesystem on redeploy.
# STATE_DIR=/var/data
